# Application Environment (auto-detected if not set)
# Options: online, offline
APP_ENV=auto

# Database Configuration
# For MySQL (default):
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=
DB_NAME=fet_timetable
DB_USER=your_db_user
DB_PASS=your_db_password

# For Supabase/PostgreSQL:
# DB_DRIVER=pgsql
# DB_HOST=db.your-project.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASS=your_supabase_password

# FET Engine Configuration
# Use fet-cl.exe for Windows, fet-cl for Linux/Mac
# The system auto-detects the correct executable based on OS
FET_ENGINE_PATH=/path/to/fet-cl
OUTPUT_DIR=/path/to/output/directory

# Security
SSO_SHARED_SECRET=your_sso_secret_key
CENTRAL_SERVER_URL=https://your-central-server.com
LOCAL_SYNC_TOKEN=your_local_sync_token

# Sync Configuration (for offline deployments)
AUTO_SYNC=true
SYNC_INTERVAL=3600
