# Application Environment
APP_ENV=online

# ============================================================
# Database — Supabase Session Pooler (REQUIRED on Render)
# ============================================================
#
# 1. Open Supabase → your project → Connect (or Project Settings → Database)
# 2. Choose "Session pooler" (port 5432)
# 3. Copy the values from that connection string
#
# Example connection string from Supabase:
#   postgresql://postgres.wofnvdfnsuevnebpkdsw:[PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
#
# Then set:

DB_DRIVER=pgsql
DB_HOST=aws-1-eu-west-3.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# CRITICAL: username must include the project ref after a dot
# Format:  postgres.YOUR_PROJECT_REF
# Wrong:   postgres
# Correct: postgres.wofnvdfnsuevnebpkdsw
DB_USER=postgres.wofnvdfnsuevnebpkdsw

DB_PASS=your_supabase_database_password

# Optional helper (used only if DB_USER is plain "postgres")
# DB_PROJECT_REF=wofnvdfnsuevnebpkdsw

# FET Engine (Dockerfile already installs this on Render)
FET_ENGINE_PATH=/var/www/html/engine/fet-cl
OUTPUT_DIR=/var/www/html/output

# Security
SSO_SHARED_SECRET=
CENTRAL_SERVER_URL=
LOCAL_SYNC_TOKEN=
