# Application Environment (auto-detected if not set)
# Options: online, offline
APP_ENV=online

# ============================================================
# Database Configuration
# ============================================================
# For local MySQL:
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=
# DB_NAME=fet_timetable
# DB_USER=root
# DB_PASS=

# For Supabase / PostgreSQL on Render (REQUIRED setup):
#
# 1. In Supabase Dashboard go to:
#    Project Settings → Database → Connection pooling
# 2. Choose "Session" mode (port 5432)
# 3. Copy the HOST from the connection string
#    (it will look like aws-0-xx-xxxx-x.pooler.supabase.com
#     or something similar — NEVER use db.xxxxx.supabase.co)
# 4. Paste that host into DB_HOST below / on Render
#
DB_DRIVER=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your_supabase_password

# FET Engine Configuration
# On Render the Dockerfile already installs fet and links it
FET_ENGINE_PATH=/var/www/html/engine/fet-cl
OUTPUT_DIR=/var/www/html/output

# Security
SSO_SHARED_SECRET=your_sso_secret_key
CENTRAL_SERVER_URL=https://your-central-server.com
LOCAL_SYNC_TOKEN=your_local_sync_token

# Sync Configuration (for offline deployments)
AUTO_SYNC=true
SYNC_INTERVAL=3600
