# Application Environment
APP_ENV=online

# Database Configuration (Supabase PostgreSQL)
DB_DRIVER=pgsql
DB_HOST=db.your-project-id.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your_supabase_password_here

# FET Engine Configuration
FET_ENGINE_PATH=/app/engine/fet-cl
OUTPUT_DIR=/app/output

# Security
SSO_SHARED_SECRET=your_64_character_hex_secret_here
CENTRAL_SERVER_URL=https://your-central-server.com
LOCAL_SYNC_TOKEN=your_per_school_sync_token_here

# Sync Configuration
AUTO_SYNC=false
SYNC_INTERVAL=3600
